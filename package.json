    "simulate-customers-daily-install-macos": "bash scripts/install-macos-launchagent.sh",
    "simulate-customers-daily-uninstall-macos": "bash scripts/uninstall-macos-launchagent.sh"
  },
  "dependencies": {
    "@amplitude/unified": "^1.0.15",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@statsig/js-client": "^3.33.3",
    "@statsig/react-bindings": "^3.33.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.53.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
