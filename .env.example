# Statsig client SDK key (Statsig console → Project Settings → API Keys → Client API Key)
VITE_STATSIG_CLIENT_KEY=

# Amplitude project API key (Amplitude → Settings → Projects → API Key). Analytics is a no-op without it.
VITE_AMPLITUDE_API_KEY=

# Optional Amplitude overrides (see src/lib/analytics.ts)
# VITE_AMPLITUDE_SESSION_REPLAY_SAMPLE_RATE=1
# VITE_AMPLITUDE_FETCH_REMOTE_CONFIG=false
# VITE_AMPLITUDE_SESSION_REPLAY_DEBUG=false

# Statsig environment tier for the Vite app. Leave unset for development in `npm run dev`.
# Customer simulation forces production via Playwright webServer unless overridden.
# VITE_STATSIG_TIER=production
